#!/bin/bash -l
#SBATCH -N4 --time=8:00:00 -J jaxleyCA3ms-100 -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=4 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=32 -C gpu -A m2043_g
# - - - E N D    O F    SLURM    C O M M A N D S
#
# Phase 4 (multi-stim) — CA3 Pyramidal, 4-stim JOINT-channel data + hybrid loss,
# 100-epoch regular-queue run on 4 nodes x 4 GPUs = 16 A100s.
#
# Data generated by scripts/gen_ca3_sharded.py with 4 stims on the probe axis:
#   $SCRATCH/synthetic_ca3_data/ca3_multistim_v1/ca3_pyramidal_multistim.mlPack1.h5
#   num_probs=4 (chaotic/step500/chirp/ramp), num_stims=1, 6 unit_par columns.
#
# vs batchShifterJaxleyCA3_100ep.slr (single-stim):
#   - cellName : ca3_pyramidal_synth -> ca3_pyramidal_multistim
#   - design   : ca3_matched         -> ca3_multistim (adds voltage_loss.stim_names_multi)
#   - probsSelect : "0" -> "0 1 2 3" (feed all 4 stim channels to the CNN)
#
# Wall-time: HybridLoss re-sims pred_phys under ALL 4 stims per step, so ~4x the
# single-stim per-step cost. At 40k train / global_batch 2048 = 20 steps/epoch,
# ~4 x 1.85 s/step ~ 150 s/epoch + val -> ~5-6 h for 100 epochs. 8 h leaves margin.
#
# Usage:
#   sbatch batchShifterJaxleyCA3Multistim_100ep.slr [data_path] [design]

set -e

cellName=${NEUINV_CELL:-ca3_pyramidal_multistim}
design=ca3_multistim
epochs=100
data_temp=${1:-/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_multistim_v1/}
if [[ $# -ge 2 ]]; then design=$2; fi

# NEUINV_PROBS overrides which probe channels (stims) feed the CNN. Default is
# all 4; set NEUINV_PROBS="1 2 3" to DROP the chaotic stim (probe 0) and train on
# step/chirp/ramp only (design ca3_multistim_voltonly_efel_nochaos). The design
# yaml's voltage_loss.stim_names_multi MUST list stims in the SAME order as the
# selected probes.
probsSelect="${NEUINV_PROBS:-0 1 2 3}"
stimsSelect="0"
validStimsSelect="0"

# ─── Conda env (jaxley + jax + torch) ───────────────────────────────────
module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1

# ─── JAX persistent compile cache (per-rank) ────────────────────────────
export JAX_COMPILATION_CACHE_DIR=$SCRATCH/jax_cc/rank_${SLURM_PROCID:-0}
mkdir -p $JAX_COMPILATION_CACHE_DIR
export JAX_PLATFORMS=cuda
# fp64 REQUIRED under DDP (NaN-propagation via NCCL otherwise). See ca3_matched.
export JAX_ENABLE_X64=true

# ─── NCCL (Perlmutter, no shifter) ──────────────────────────────────────
export NCCL_DEBUG=WARN
export NCCL_NET_GDR_LEVEL=PHB
export FI_PROVIDER=cxi
export FI_CXI_DEFAULT_CQ_SIZE=131072
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.5

# ─── DDP env ────────────────────────────────────────────────────────────
nprocspn=${SLURM_NTASKS_PER_NODE}
N=${SLURM_NNODES}
G=$[ $N * $nprocspn ]
# First COMPUTE node of the allocation (robust under both sbatch and
# `salloc ... bash script`, where the body runs on the login node and plain
# `hostname` would wrongly resolve to the login node). Use a distinct port from
# the single-stim run so two concurrent interactive allocations never clash.
export MASTER_ADDR=$(scontrol show hostnames "${SLURM_JOB_NODELIST:-$(hostname)}" | head -n1)
export MASTER_PORT=8882
echo "S: job=${SLURM_JOBID} MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT G=$G N=$N"

facility=perlmutter
[[ -z "${NEUINV_WRK_SUFIX}" ]] && wrkSufix=$SLURM_JOBID || wrkSufix="${NEUINV_WRK_SUFIX}"
[[ -z "${NEUINV_JOBID}"    ]] && jobId=j$SLURM_JOBID    || jobId="${design}_${NEUINV_JOBID}"

wrkDir0=$SCRATCH/tmp_neuInv/jaxley_ca3_multistim/${design}/${cellName}/
wrkDir=$wrkDir0/$wrkSufix
outPath=$wrkDir/out
mkdir -p $outPath

# Frozen code snapshot.
codeList="train_dist.py predict.py predictExp.py RayTune.py toolbox/ \
batchShifterJaxleyCA3Multistim_100ep.slr evaluate_voltage.py plotJaxleyValidation.py \
scripts/ ${design}.hpar.yaml"
cp -rp $codeList $wrkDir
cd $wrkDir
echo "S:lsfPWD=`pwd` outPath=$outPath"

# ─── Optional fine-tune (warm-start) from a pretrained model ─────────────
FT_ARGS=""
[[ -n "${NEUINV_FT_MODEL}" ]] && FT_ARGS="--do_fine_tune --fine_tune-blank_model ${NEUINV_FT_MODEL} --fine_tune-checkpoint_name ${NEUINV_FT_CKPT}"
[[ -n "${NEUINV_INITLR}" ]] && FT_ARGS="$FT_ARGS --initLR ${NEUINV_INITLR}"

# ─── Train ──────────────────────────────────────────────────────────────
# 50k pack -> train split = 80% = 40000 samples.
PY_CMD="python -u train_dist.py \
    --cellName $cellName --facility $facility \
    --outPath ./out --design $design --jobId $jobId \
    --probsSelect $probsSelect --stimsSelect $stimsSelect \
    --validStimsSelect $validStimsSelect \
    --epochs $epochs --data_path_temp $data_temp \
    --numGlobSamp 40000 $FT_ARGS"
echo "S:PY_CMD=$PY_CMD"

date
time srun -n $G bash -c "
export JAX_COMPILATION_CACHE_DIR=\$SCRATCH/jax_cc/rank_\$SLURM_PROCID
mkdir -p \$JAX_COMPILATION_CACHE_DIR
$PY_CMD" >& log.train
echo "S:done train"
date

# ─── Auto-eval: ion-channel recovery (predict.py) + voltage traces ───────
# For multi-stim the CNN gets all 4 stim channels; the voltage-trace overlay
# is evaluated on probe 0 (the chaotic stim). Writes ./out/ and ./out/eval/.
echo "S:running eval on ./out"
srun -n1 python -u predict.py --modelPath ./out --dom test -X >& log.predict || echo "S:predict FAILED"
srun -n1 python -u evaluate_voltage.py --modelPath ./out --numSamples 200 --numOverlay 20 >& log.evalvolt || echo "S:evalvolt FAILED"
echo "S:done eval"
grep -E "#res,MSEloss|Average loss" log.predict 2>/dev/null | tail -2
grep -E "overall MSE|mean R²|voltage MSE_z|spike count" log.evalvolt 2>/dev/null | tail -4

tail -50 log.train
