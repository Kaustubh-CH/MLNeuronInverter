#!/bin/bash -l
#SBATCH -N8 --time=12:00:00 -J ca3vo-amp8n -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=4 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=32 -C gpu -A m2043_g
# 200k soft-DTW (primary) + small soft-eFEL(voltage_base, AP_amplitude) aux -- adds
# explicit differentiable resting-potential + AP-amplitude pressure to fix the level/
# amplitude drift DTW tolerates. Same data (v3 200k), global batch 2048 (64 x 32), 150
# epochs -> apples-to-apples with dtw_200k (0.725), ONLY the two eFEL features differ.
# eFEL feature graphs add backward cost over pure DTW (~221 s/epoch) -> 12h wall margin.
# STRICTLY voltage-only (channel_weight 0, mask_channels True; features are trace-only).
set -u
WT=/global/u1/k/ktub1999/Neuron/neuron4/neuroninverter/.claude/worktrees/ca3-vo-dtwblur
cd "$WT" || exit 2
V3=/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_chaoticramp_v3/
J=$SCRATCH/tmp_neuInv/jaxley_ca3
export NEUINV_RDZV_FILE=$SCRATCH/tmp_neuInv/rdzv/rdzv_${SLURM_JOBID}
mkdir -p "$(dirname "$NEUINV_RDZV_FILE")"; rm -f "$NEUINV_RDZV_FILE"
export NCCL_P2P_DISABLE=1
echo "TRAIN-amp-8n: start $(date) job=$SLURM_JOBID nodes=$SLURM_JOB_NODELIST rdzv=$NEUINV_RDZV_FILE"
NEUINV_WRK_SUFIX=dtw_amp_200k NEUINV_NUMGLOBSAMP=200000 NEUINV_EPOCHS=150 \
  bash batchShifterJaxleyCA3_100ep.slr "$V3" ca3_vo_chaoticramp_dtw_amp_8n
echo "TRAIN-amp-8n: launcher exit=$? $(date)"
module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1
RUN=$J/ca3_vo_chaoticramp_dtw_amp_8n/ca3_pyramidal_synth/dtw_amp_200k
if [ -f "$RUN/out/eval/summary.yaml" ]; then
  echo "TRAIN-amp-8n: ===== ledger ====="
  python scripts/collect_vo_ledger.py "$RUN" -o "$J/vo_ledger/results.csv"
else
  echo "TRAIN-amp-8n: NO eval summary at $RUN/out/eval/ - check $RUN/log.*"
fi
echo "TRAIN-amp-8n: done $(date)"
