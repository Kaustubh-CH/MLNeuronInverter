#!/bin/bash -l
#SBATCH -N8 --time=6:00:00 -J ca3vo-ray -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=1 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=64 -C gpu -A m2043_g
# - - - E N D    O F    SLURM    C O M M A N D S
#
# Phase 6 (MULTI-NODE) — Ray Tune HPO for the CA3 voltage-only (soft-DTW) path.
#
# 8-node / 32-GPU Ray cluster: a Ray HEAD on node 0 + 7 WORKERS (each `ray start`
# claims that node's 4 GPUs). gpus_per_trial=1 -> up to 32 concurrent single-GPU
# trials. do_ray:True in ca3_vo_ray.hpar.yaml forces world_size=1 in train_dist.py
# (no DDP inside a trial). RayTune.py does ray.init(address="auto") to join this
# cluster and runs num_samples=128 Optuna trials under ASHA(max_t=20, grace=5, rf=3).
# Each trial tunes CNN depth/filters/kernels/pools, FC depth/dims, batch, dropFrac,
# LR AND per-epoch dataset size {2000,4000,8000}. STRICTLY VOLTAGE-ONLY (pure DTW).
#
# Usage:  sbatch batchShifterJaxleyCA3_ray.slr

set -e

cellName=ca3_pyramidal_synth
design=ca3_vo_ray
epochs=20
data_temp=/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_chaoticramp_v1/
facility=perlmutter
probsSelect="0"; stimsSelect="0"; validStimsSelect="0"

# ─── Conda env (jaxley + jax + torch + ray + optuna) ────────────────────
module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1

# ─── JAX (fp64 voltage-only) ────────────────────────────────────────────
export JAX_PLATFORMS=cuda
export JAX_ENABLE_X64=true
export XLA_PYTHON_CLIENT_PREALLOCATE=false
# Ray pins each trial to ONE GPU via CUDA_VISIBLE_DEVICES -> 0.9 fraction/GPU is safe.
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
# CRITICAL: no SHARED compile cache (concurrent trials would race) -> compile in-memory.
unset JAX_COMPILATION_CACHE_DIR

# train_dist.py reads SLURM_PROCID/SLURM_NTASKS/MASTER_ADDR directly (do_ray forces
# world_size=1 so no real DDP, but the logging line needs them defined).
export SLURM_PROCID=${SLURM_PROCID:-0}
export SLURM_NTASKS=${SLURM_NTASKS:-1}
export MASTER_ADDR=$(hostname)
export MASTER_PORT=8892

# ─── Run dir + frozen code snapshot ─────────────────────────────────────
wrkDir=$SCRATCH/tmp_neuInv/jaxley_ca3_ray/$SLURM_JOBID
outPath=$wrkDir/out
mkdir -p $outPath $wrkDir/promoted_yamls
codeList="train_dist.py predict.py predictExp.py RayTune.py toolbox/ \
batchShifterJaxleyCA3_ray.slr evaluate_voltage.py plotJaxleyValidation.py \
plot_exp_overlay.py scripts/ ${design}.hpar.yaml"
cp -rp $codeList $wrkDir
cd $wrkDir
echo "S:lsfPWD=`pwd` outPath=$outPath"

# ─── Start the Ray cluster across all nodes ─────────────────────────────
nodes_array=($(scontrol show hostnames "$SLURM_JOB_NODELIST"))
head_node=${nodes_array[0]}
head_ip=$(srun --nodes=1 --ntasks=1 -w "$head_node" hostname --ip-address)
port=6379
ip_head=$head_ip:$port
echo "S: ray head=$head_node ip_head=$ip_head nNodes=${#nodes_array[@]}"

# Head (blocks -> background). Claims node 0's 4 GPUs.
srun --nodes=1 --ntasks=1 -w "$head_node" \
    ray start --head --node-ip-address="$head_ip" --port=$port \
    --num-cpus 60 --num-gpus 4 --block &
sleep 25

# Workers (nodes 1..N-1), each claims its 4 GPUs.
for ((i = 1; i < ${#nodes_array[@]}; i++)); do
    node_i=${nodes_array[$i]}
    echo "S: starting ray worker on $node_i"
    srun --nodes=1 --ntasks=1 -w "$node_i" \
        ray start --address "$ip_head" \
        --num-cpus 60 --num-gpus 4 --block &
    sleep 5
done
sleep 25
echo "S: ray cluster status (expect ~32 GPUs):"
ray status 2>&1 | head -40 || true

# ─── Run the tuning driver on the head node (connects via ray.init(auto)) ─
PY_CMD="python -u train_dist.py \
    --design $design --cellName $cellName --facility $facility \
    --outPath ./out --jobId ray$SLURM_JOBID \
    --probsSelect $probsSelect --stimsSelect $stimsSelect \
    --validStimsSelect $validStimsSelect \
    --epochs $epochs --data_path_temp $data_temp \
    --minLoss-RayTune-yamlPath $wrkDir/promoted_yamls"
echo "S:PY_CMD=$PY_CMD"
date
$PY_CMD >& $wrkDir/log.ray || echo "S:ray exited non-zero (see log.ray)"
date
ray stop 2>&1 | head || true
echo "S:done ray-tune"
echo "S:promoted yamls (below minLoss):"
ls -la $wrkDir/promoted_yamls 2>/dev/null || true
tail -80 $wrkDir/log.ray
