#!/bin/bash -l
#SBATCH -N1 --time=6:00:00 -J ca3vo-ray -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=1 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=64 -C gpu -A m2043_g
# - - - E N D    O F    SLURM    C O M M A N D S
#
# Phase 6 — Ray Tune ARCHITECTURE HPO for the CA3 voltage-only (soft-DTW) path.
#
# Single-node, single-task launcher: Ray manages all 4 GPUs on the node and runs
# 4 concurrent single-GPU trials (gpus_per_trial=1 in RayTune.py). do_ray:True in
# ca3_vo_ray.hpar.yaml forces world_size=1 in train_dist.py (NO DDP, NO srun).
# ASHAScheduler(max_t=20, grace_period=5, reduction_factor=3) early-stops trials
# on the per-epoch validation loss. num_samples=48 trials; each trial tunes CNN
# depth/filters/kernels/pools, FC depth/dims, batch size, dropFrac, LR AND the
# per-epoch dataset size (max_glob_samples_per_epoch in {2000,4000,8000}).
#
# Trials are STRICTLY VOLTAGE-ONLY (pure soft-DTW; mse/efel/channel weights = 0).
# Below-threshold trials dump their model: block to $wrkDir/promoted_yamls.
#
# Usage:
#   sbatch batchShifterJaxleyCA3_ray.slr

set -e

cellName=ca3_pyramidal_synth
design=ca3_vo_ray
epochs=20
data_temp=/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_chaoticramp_v1/
facility=perlmutter

probsSelect="0"
stimsSelect="0"
validStimsSelect="0"

# ─── Conda env (jaxley + jax + torch + ray + optuna) ────────────────────
module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1

# ─── JAX (fp64 voltage-only) ────────────────────────────────────────────
export JAX_PLATFORMS=cuda
export JAX_ENABLE_X64=true
export XLA_PYTHON_CLIENT_PREALLOCATE=false
# Ray pins each trial to ONE GPU via CUDA_VISIBLE_DEVICES, so each of the 4
# concurrent jax processes owns its own GPU -> 0.9 fraction is safe per-GPU.
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
# CRITICAL: no SHARED compile cache. 4 concurrent trials would race on a shared
# JAX_COMPILATION_CACHE_DIR -> nondeterministic XLA crashes; compile in-memory.
unset JAX_COMPILATION_CACHE_DIR

# ─── Single-task launch env (no srun; Ray owns the node) ────────────────
# train_dist.py reads SLURM_PROCID/SLURM_NTASKS/MASTER_ADDR directly; the batch
# script is not a job step, so SLURM_PROCID may be unset -> default it.
export SLURM_PROCID=${SLURM_PROCID:-0}
export SLURM_NTASKS=${SLURM_NTASKS:-1}
export MASTER_ADDR=$(hostname)
export MASTER_PORT=8892
echo "S: job=${SLURM_JOBID} MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT design=$design"

# ─── Run dir + frozen code snapshot ─────────────────────────────────────
wrkDir=$SCRATCH/tmp_neuInv/jaxley_ca3_ray/$SLURM_JOBID
outPath=$wrkDir/out
mkdir -p $outPath
mkdir -p $wrkDir/promoted_yamls

# codeList already carries RayTune.py; ${design}.hpar.yaml == ca3_vo_ray.hpar.yaml.
codeList="train_dist.py predict.py predictExp.py RayTune.py toolbox/ \
batchShifterJaxleyCA3_ray.slr evaluate_voltage.py plotJaxleyValidation.py \
plot_exp_overlay.py scripts/ ${design}.hpar.yaml"
cp -rp $codeList $wrkDir
cd $wrkDir
echo "S:lsfPWD=`pwd` outPath=$outPath"

# ─── Ray Tune (single python process; Ray spawns the 4 trial workers) ───
PY_CMD="python -u train_dist.py \
    --design $design --cellName $cellName --facility $facility \
    --outPath ./out --jobId ray$SLURM_JOBID \
    --probsSelect $probsSelect --stimsSelect $stimsSelect \
    --validStimsSelect $validStimsSelect \
    --epochs $epochs --data_path_temp $data_temp \
    --minLoss-RayTune-yamlPath $wrkDir/promoted_yamls"
echo "S:PY_CMD=$PY_CMD"

date
$PY_CMD >& $wrkDir/log.ray || echo "S:ray exited non-zero (see log.ray)"
echo "S:done ray-tune"
date

echo "S:promoted yamls (below minLoss):"
ls -la $wrkDir/promoted_yamls 2>/dev/null || true
tail -60 $wrkDir/log.ray
