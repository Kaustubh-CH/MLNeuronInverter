#!/bin/bash -l
#SBATCH -N8 --time=11:00:00 -J ca3vo-icaB8n -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=4 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=32 -C gpu -A m2043_g
# InterChaoticB analogue of the winning chaoticRamp run: pure soft-DTW, 200k data,
# global batch 2048 (64 x 32), 150 epochs. Stim = 5k50kInterChaoticB (same 5001-pt
# length as 5kChaoticRamp -> same ~221 s/epoch; 150 x 221.5 ~= 9.3h < 11h wall).
# Depends on the ca3_5kinterchaoticB_v1 pack (gen_interchaoticB_v1.slr). STRICTLY
# voltage-only (channel_weight 0, mask_channels True).
set -u
WT=/global/u1/k/ktub1999/Neuron/neuron4/neuroninverter/.claude/worktrees/ca3-vo-dtwblur
cd "$WT" || exit 2
PACK=/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_5kinterchaoticB_v1/
J=$SCRATCH/tmp_neuInv/jaxley_ca3
export NEUINV_RDZV_FILE=$SCRATCH/tmp_neuInv/rdzv/rdzv_${SLURM_JOBID}
mkdir -p "$(dirname "$NEUINV_RDZV_FILE")"; rm -f "$NEUINV_RDZV_FILE"
export NCCL_P2P_DISABLE=1
echo "TRAIN-icaB-8n: start $(date) job=$SLURM_JOBID nodes=$SLURM_JOB_NODELIST rdzv=$NEUINV_RDZV_FILE"
NEUINV_WRK_SUFIX=dtw_ica_200k NEUINV_NUMGLOBSAMP=200000 NEUINV_EPOCHS=150 \
  bash batchShifterJaxleyCA3_100ep.slr "$PACK" ca3_vo_interchaoticB_dtw_8n
echo "TRAIN-icaB-8n: launcher exit=$? $(date)"
module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1
RUN=$J/ca3_vo_interchaoticB_dtw_8n/ca3_pyramidal_synth/dtw_ica_200k
if [ -f "$RUN/out/eval/summary.yaml" ]; then
  echo "TRAIN-icaB-8n: ===== ledger ====="
  python scripts/collect_vo_ledger.py "$RUN" -o "$J/vo_ledger/results.csv"
else
  echo "TRAIN-icaB-8n: NO eval summary at $RUN/out/eval/ - check $RUN/log.*"
fi
echo "TRAIN-icaB-8n: done $(date)"
