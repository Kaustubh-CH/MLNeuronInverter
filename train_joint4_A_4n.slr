#!/bin/bash -l
#SBATCH -N4 --time=24:00:00 -J ca3vo-joint4A -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=4 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=32 -C gpu -A m2043_g
# VARIANT A — 80k clean 4-stim battery, stims as separate CNN CHANNELS.
# Champion objective verbatim (soft-DTW + ramped eFEL aux); only the data changes.
# 64k train rows x 4 stims = 256k solves/epoch, 62 steps/epoch at global batch
# 1024 (64 x 16). ~6.6 min/epoch extrapolated from dtw_200k's 4.1 min at 160k
# solves -> ~11 h for 100 epochs, comfortably inside the 24 h wall.
# Pack must exist: submit with --dependency=afterok:<gen job>.
set -u
WT=/global/u1/k/ktub1999/Neuron/neuron4/neuroninverter/.claude/worktrees/ca3-vo-dtwblur
cd "$WT" || exit 2
PACK=/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_joint4_v1/
J=$SCRATCH/tmp_neuInv/jaxley_ca3

if [ ! -f "$PACK/ca3_pyramidal_joint4.mlPack1.h5" ]; then
  echo "JOINT4-A: FATAL missing pack $PACK/ca3_pyramidal_joint4.mlPack1.h5"; exit 3
fi

export NEUINV_RDZV_FILE=$SCRATCH/tmp_neuInv/rdzv/rdzv_${SLURM_JOBID}
mkdir -p "$(dirname "$NEUINV_RDZV_FILE")"; rm -f "$NEUINV_RDZV_FILE"
export NCCL_P2P_DISABLE=1
echo "JOINT4-A: start $(date) job=$SLURM_JOBID nodes=$SLURM_JOB_NODELIST"

# probsSelect 0 1 2 3 -> the battery is on the PROBE axis (num_probs=4, num_stims=1).
# cellName MUST equal the pack's H5 stem or the loader cannot find the file.
NEUINV_CELL=ca3_pyramidal_joint4 \
NEUINV_PROBS="0 1 2 3" NEUINV_STIMS="0" NEUINV_VALIDSTIMS="0" \
NEUINV_WRK_SUFIX=joint4_80k NEUINV_NUMGLOBSAMP=80000 NEUINV_EPOCHS=100 \
  bash batchShifterJaxleyCA3_100ep.slr "$PACK" ca3_joint4_dtw_amp_4n
echo "JOINT4-A: launcher exit=$? $(date)"

module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1
RUN=$J/ca3_joint4_dtw_amp_4n/ca3_pyramidal_joint4/joint4_80k
if [ -f "$RUN/out/eval/summary.yaml" ]; then
  echo "JOINT4-A: ===== ledger ====="
  python scripts/collect_vo_ledger.py "$RUN" -o "$J/vo_ledger/results.csv"
else
  echo "JOINT4-A: NO eval summary at $RUN/out/eval/ - check $RUN/log.*"
fi
echo "JOINT4-A: done $(date)"
