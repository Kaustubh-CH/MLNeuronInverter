#!/bin/bash -l
#SBATCH -N8 --time=11:00:00 -J ca3vo-pkdr8n -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=4 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=32 -C gpu -A m2043_g
# 200k + grad-precond with a STRONG isolated kdr boost (x2.5 vs prior max 1.68).
# Same data (v3 200k), same global batch 2048 (64 x 32) as dtw_200k (0.725) so it is
# apples-to-apples -- ONLY the grad_precond block differs. 150 epochs (dtw_200k's val
# loss was STILL dropping at ep94 -> 100 was too few); 150 x 221.5s ~= 9.3h < 11h wall.
# STRICTLY voltage-only.
set -u
WT=/global/u1/k/ktub1999/Neuron/neuron4/neuroninverter/.claude/worktrees/ca3-vo-dtwblur
cd "$WT" || exit 2
V3=/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_chaoticramp_v3/
J=$SCRATCH/tmp_neuInv/jaxley_ca3
export NEUINV_RDZV_FILE=$SCRATCH/tmp_neuInv/rdzv/rdzv_${SLURM_JOBID}
mkdir -p "$(dirname "$NEUINV_RDZV_FILE")"; rm -f "$NEUINV_RDZV_FILE"
export NCCL_P2P_DISABLE=1
echo "TRAIN-pkdr-8n: start $(date) job=$SLURM_JOBID nodes=$SLURM_JOB_NODELIST rdzv=$NEUINV_RDZV_FILE"
NEUINV_WRK_SUFIX=precondkdr_200k NEUINV_NUMGLOBSAMP=200000 NEUINV_EPOCHS=150 \
  bash batchShifterJaxleyCA3_100ep.slr "$V3" ca3_vo_chaoticramp_dtw_precondkdr_8n
echo "TRAIN-pkdr-8n: launcher exit=$? $(date)"
module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1
RUN=$J/ca3_vo_chaoticramp_dtw_precondkdr_8n/ca3_pyramidal_synth/precondkdr_200k
if [ -f "$RUN/out/eval/summary.yaml" ]; then
  echo "TRAIN-pkdr-8n: ===== ledger ====="
  python scripts/collect_vo_ledger.py "$RUN" -o "$J/vo_ledger/results.csv"
else
  echo "TRAIN-pkdr-8n: NO eval summary at $RUN/out/eval/ - check $RUN/log.*"
fi
echo "TRAIN-pkdr-8n: done $(date)"
