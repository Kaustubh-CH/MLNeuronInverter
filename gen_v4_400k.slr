#!/bin/bash -l
#SBATCH -N4 --time=2:30:00 -J ca3gen-v4 -q regular
#SBATCH -o /pscratch/sd/k/ktub1999/tmp_neuInv/slurm_logs/slurm-%j.out
#SBATCH --ntasks-per-node=4 --gpus-per-node=4 --gpu-bind=none --cpus-per-task=32 -C gpu -A m2043_g
# Generate the v4 CA3 chaoticRamp pack: 500k total -> 400k train / 50k valid / 50k test.
# Same generator/stim(5kChaoticRamp)/seed(0) as v1(40k)/v2(80k)/v3(200k) so the
# data-scaling curve stays a clean single-variable sweep. The 200k point (0.725) had
# not saturated (curve accelerating; kdr still climbing) -> 400k is the next point.
# gen v3 (250k) took ~3.4 min on 16 GPU -> 500k ~7 min. 16 shards (4 nodes x 4 GPU).
set -u
WT=/global/u1/k/ktub1999/Neuron/neuron4/neuroninverter/.claude/worktrees/ca3-vo-dtwblur
cd "$WT" || exit 2
OUT=/pscratch/sd/k/ktub1999/synthetic_ca3_data/ca3_chaoticramp_v4
echo "GEN-v4: start $(date) job=$SLURM_JOBID nodes=$SLURM_JOB_NODELIST"
bash scripts/run_ca3_gen.sh ca3_pyramidal_synth "$OUT" 5kChaoticRamp 500000
rc=$?
echo "GEN-v4: run_ca3_gen exit=$rc $(date)"
module load python
source activate /pscratch/sd/k/ktub1999/conda_envs/neuroninverter_jaxley
export PYTHONNOUSERSITE=1
python - "$OUT/ca3_pyramidal_synth.mlPack1.h5" <<'PY'
import sys, h5py
f=sys.argv[1]
with h5py.File(f,'r') as h:
    tr=h['train_volts_norm'].shape; tp=h['train_phys_par'].shape
    print("GEN-v4 VALIDATE:", f)
    print("  train_volts_norm", tr, " train_phys_par", tp)
    assert tr[0]>=400000, f"train too small: {tr[0]}"
    assert tp[1]==6, f"expected 6 params, got {tp[1]}"
print("GEN-v4 VALIDATE: OK")
PY
echo "GEN-v4: done $(date)"
